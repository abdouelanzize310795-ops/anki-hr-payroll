# Mshahara — copier en .env.local
# Secret pour les sessions et les liens de fichiers signés (chaîne aléatoire longue)
SESSION_SECRET=change-me
# Mot de passe PostgreSQL (docker-compose)
POSTGRES_PASSWORD=mshahara
# Hors Docker uniquement : DATABASE_URL=postgres://mshahara:mshahara@127.0.0.1:5433/mshahara
# Compte administrateur plateforme créé au démarrage
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- E-mails (mot de passe oublié, confirmation d'adresse) ---
# Réglages SMTP de LWS (hébergeur de mshahara.online).
# Sans SMTP_HOST, ces fonctions sont désactivées et les inscriptions sont confirmées d'office.
SMTP_HOST=mail.mshahara.online
SMTP_PORT=465
SMTP_USER=contact@mshahara.online
SMTP_PASS=
SMTP_FROM=Mshahara <contact@mshahara.online>
APP_URL=https://mshahara.online
