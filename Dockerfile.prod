# Production image: compiled Node server (no Vite dev server, no source served).
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npx vite build

FROM node:22-slim
# Chromium renders payslips to PDF with the employer's template.
RUN apt-get update && apt-get install -y --no-install-recommends chromium fonts-dejavu-core fonts-liberation \
 && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production CHROMIUM_PATH=/usr/bin/chromium PORT=8080 HOST=0.0.0.0
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY --from=build /app/.output ./.output
COPY db ./db
COPY supabase/migrations ./supabase/migrations
RUN mkdir -p /data/uploads && chown node:node /data/uploads
USER node
EXPOSE 8080
CMD ["sh", "-c", "node db/migrate.mjs && node db/seed.mjs && node .output/server/index.mjs"]
